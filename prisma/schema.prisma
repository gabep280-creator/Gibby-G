// Noah's Pork Rinds — Vendor Route Management
// Prisma schema. SQLite for local/dev; swap datasource provider to
// "postgresql" (and update prisma.config.ts) to move to Postgres later.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A retail/wholesale stop the driver delivers to.
model Location {
  id             String   @id @default(cuid())
  name           String
  address        String
  lat            Float
  lng            Float
  storeType      String? // e.g. "Convenience", "Grocery", "Gas Station"
  notes          String?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  visitFrequency String? // e.g. "weekly", "biweekly", "monthly"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salesRecords SalesRecord[]
  routeStops   RouteStop[]

  @@index([name])
}

// A flavor/SKU that Noah's Pork Rinds sells.
model Product {
  id        String   @id @default(cuid())
  sku       String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  salesRecords SalesRecord[]

  @@index([name])
}

// Units sold of a Product at a Location over a period (typically one visit).
// This is the raw input the A/B/C grading is computed from.
model SalesRecord {
  id          String    @id @default(cuid())
  locationId  String
  productId   String
  unitsSold   Int
  periodStart DateTime  @default(now())
  periodEnd   DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([productId])
  @@index([periodStart])
}

// A planned delivery route for a given day (optionally a specific driver).
model Route {
  id         String    @id @default(cuid())
  name       String
  date       DateTime  @default(now())
  driverName String? // future: multi-driver support
  status     String    @default("planned") // planned | in_progress | completed
  totalDistanceMeters  Int?
  totalDurationSeconds Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  stops RouteStop[]
}

// One stop within a Route, in driving order.
model RouteStop {
  id          String    @id @default(cuid())
  routeId     String
  locationId  String
  sequence    Int
  status      String    @default("pending") // pending | completed | skipped
  arrivedAt   DateTime?
  completedAt DateTime?

  // Leg from the previous stop (or route start) to this stop.
  distanceFromPrevMeters  Int?
  durationFromPrevSeconds Int?

  // Future features — kept nullable so they can be populated without a migration surprise.
  photoUrl     String?
  signatureUrl String?
  visitNotes   String?

  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([routeId, locationId])
  @@index([routeId])
  @@index([locationId])
}
